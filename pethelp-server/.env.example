# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=pethelp
DB_PASSWORD=pethelp_dev
DB_NAME=pethelp

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# WeChat Mini Program (必填 — 从微信公众平台获取)
WECHAT_APPID=your_wechat_appid_here
WECHAT_SECRET=your_wechat_secret_here

# CORS (生产填域名，开发用 localhost)
CORS_ORIGIN=https://pethelp.cloud

# JWT (生产环境必须换强随机密码，推荐 openssl rand -hex 32)
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# LLM Provider
LLM_PROVIDER=deepseek
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
